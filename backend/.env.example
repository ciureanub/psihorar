# PostgreSQL connection string
DATABASE_URL=postgresql://psihorar:psihorar@localhost:5432/psihorar

# Admin login (in-app login screen). Set your own values; never commit real ones.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret used to sign admin session tokens (long random string).
ADMIN_TOKEN_SECRET=

# Apple Push Notification service (token-based auth, .p8 key)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8=
APNS_BUNDLE_ID=

# Optional
PORT=3000
RATE_LIMIT_PER_MINUTE=120
# Used by the CLI only
PSIHORAR_API_URL=http://localhost:3000
