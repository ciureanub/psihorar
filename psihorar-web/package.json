{
  "name": "psihorar-web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:html": "tsx scripts/build-html.ts",
    "build:check": "esbuild scripts/check-diff.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/check-diff.mjs \"--banner:js=import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\"",
    "check:diff": "node scripts/check-diff.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
